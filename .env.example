# ──────────────────────────────────────────────────────────────────
# Marketing Powered — environment configuration
# Copy this file to `.env.local` (local dev) and set the same values in
# the Vercel project's Environment Variables for production.
# Every value is OPTIONAL: with none set the site builds and runs, but
# booking and analytics stay dormant until you fill these in. Lead forms need
# GOOGLE_SHEETS_WEBHOOK_URL (or the Resend backup): with neither working, a
# submission shows the form's "could not send" message.
# ──────────────────────────────────────────────────────────────────

# ---- Site ----------------------------------------------------------
# Canonical origin (no trailing slash). Drives metadataBase, canonical
# URLs, sitemap.xml, and robots.txt. Set this before going live.
NEXT_PUBLIC_SITE_URL=https://marketingpowered.ai

# ---- Lead delivery (Google Sheet + info@ email) -------------------
# Web app URL of the Apps Script attached to the "Marketing Powered Website
# Leads" sheet (setup steps at the top of scripts/google-sheets-leads.gs).
# For every form submission the script appends a row to the sheet's Leads
# tab and emails the lead to info@marketingpowered.ai (Reply-To = prospect).
# Check a deployment from a terminal: node scripts/sheet-test.mjs "<url>"
GOOGLE_SHEETS_WEBHOOK_URL=

# ---- Backup lead email (Resend, optional) --------------------------
# Used only when the sheet script did not send the lead email (unreachable
# or its mail step failed), so info@ never gets a lead twice. Unset = no
# backup. Get a key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
# Backup recipients, comma-separated. Defaults to info@marketingpowered.ai.
LEADS_EMAIL=info@marketingpowered.ai
# Verified sender. Must be on a domain you've verified in Resend.
# Defaults to Resend's shared test sender (onboarding@resend.dev) if unset.
LEADS_FROM_EMAIL=Marketing Powered <leads@marketingpowered.ai>

# ---- Booking / scheduling -----------------------------------------
# Calendly / SavvyCal / HubSpot meetings scheduling link. When set it's
# embedded on /get-started/book-a-call/. When unset that page falls back
# to the lead form.
NEXT_PUBLIC_BOOKING_URL=

# ---- Analytics / tracking -----------------------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Loads only when set.
NEXT_PUBLIC_GA4_ID=
# Meta (Facebook) Pixel ID, e.g. 123456789012345. Loads only when set.
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Powered Cards checkout (Stripe) --------------------------------
# /cards/order takes payment through embedded Stripe Checkout. Both keys
# come from the same Stripe account (Developers → API keys). With either
# unset the order page still renders and offers an email order instead.
# Server-side secret key (sk_live_... or sk_test_...). Never NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# Browser-side publishable key (pk_live_... or pk_test_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
