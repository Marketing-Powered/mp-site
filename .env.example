# ──────────────────────────────────────────────────────────────────
# Marketing Powered — environment configuration
# Copy this file to `.env.local` (local dev) and set the same values in
# the Vercel project's Environment Variables for production.
# Every value is OPTIONAL: with none set the site builds and runs, but
# lead emails, booking, and analytics stay dormant until you fill these in.
# ──────────────────────────────────────────────────────────────────

# ---- Site ----------------------------------------------------------
# Canonical origin (no trailing slash). Drives metadataBase, canonical
# URLs, sitemap.xml, and robots.txt. Set this before going live.
NEXT_PUBLIC_SITE_URL=https://marketingpowered.ai

# ---- Lead delivery (Resend) ---------------------------------------
# Contact / audit / call / qualification forms email submissions here.
# Without RESEND_API_KEY *and* LEADS_EMAIL the form still succeeds and the
# lead is written to the server logs, but no email is sent.
# Get a key at https://resend.com (and verify your sending domain).
RESEND_API_KEY=
# Destination inbox for leads. Comma-separate for multiple recipients.
LEADS_EMAIL=leads@marketingpowered.ai
# Verified sender. Must be on a domain you've verified in Resend.
# Defaults to Resend's shared test sender (onboarding@resend.dev) if unset.
LEADS_FROM_EMAIL=Marketing Powered <leads@marketingpowered.ai>

# ---- Lead delivery (GoHighLevel) ----------------------------------
# Inbound Webhook trigger URL from a GHL Workflow. When set, every form
# submission is also POSTed here as normalized JSON (full_name, first_name,
# last_name, email, phone, company, message, source + passthrough fields).
# Runs independently of Resend and best-effort: a GHL failure never blocks
# the email path, and when unset GHL delivery is skipped silently.
GHL_WEBHOOK_URL=

# ---- Booking / scheduling -----------------------------------------
# Calendly / SavvyCal / HubSpot meetings scheduling link. When set it's
# embedded on /get-started/book-a-call/. When unset that page falls back
# to the lead form.
NEXT_PUBLIC_BOOKING_URL=

# ---- Analytics / tracking -----------------------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Loads only when set.
NEXT_PUBLIC_GA4_ID=
# Meta (Facebook) Pixel ID, e.g. 123456789012345. Loads only when set.
NEXT_PUBLIC_META_PIXEL_ID=
