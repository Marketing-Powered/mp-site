# MAIOS environment configuration (plan, Appendix B)
# Non-secret configuration only. Real secrets live in the secret manager and are
# referenced here — never committed, never logged, never shipped to the browser.

# Application
APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
RELEASE_VERSION=dev
FEATURE_FLAG_SOURCE=database

# Database (service-specific users; password via secret manager)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=maios
POSTGRES_USER=maios_api
POSTGRES_PASSWORD=change-me-in-secret-manager
DATABASE_URL=postgres://maios_api:change-me-in-secret-manager@localhost:5432/maios

# Redis (queue prefixes include environment)
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=maios:local

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# OIDC (Authentik / Keycloak / managed OIDC)
OIDC_ISSUER=
OIDC_CLIENT_ID=maios-web
OIDC_CLIENT_SECRET=
SESSION_SECRET=

# Close (Phase 1 CRM/telephony execution — tokens encrypted, adapter-only)
CLOSE_API_BASE=https://api.close.com/api/v1
CLOSE_API_KEY_REF=secret://close/internal-org-api-key
CLOSE_WEBHOOK_SECRET_REF=secret://close/webhook-signing
CLOSE_ORGANIZATION_ID=
CLOSE_FIELD_MANIFEST_VERSION=1

# n8n
N8N_HOST=http://localhost:5678
N8N_ENCRYPTION_KEY_REF=secret://n8n/encryption-key

# TNAS (asset service / backup job only — never browser, never general n8n)
TNAS_LOGICAL_ROOT=/maios
TNAS_SERVICE_ENDPOINT=
TNAS_SERVICE_ACCOUNT_REF=secret://tnas/asset-service

# Model gateway (agents use aliases, never credentials)
MODEL_GATEWAY_URL=http://localhost:8080
MODEL_DEFAULT_ALIAS=maios-default

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info

# Tracking
TRACKING_PUBLIC_HOST=http://localhost:4100
